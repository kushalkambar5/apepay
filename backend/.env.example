# ApePay Backend Environment Example
PORT=4000
HOST=0.0.0.0
DATABASE_URL=postgres://postgres:postgres@localhost:5432/apepay
BACKEND_URI=http://localhost:4000
FRONTEND_URI=http://localhost:3000
ANVIL_RPC_URL=http://127.0.0.1:8545
JWT_SECRET=your_jwt_secret_here
NODE_ENV=development
# zkBob Pool — set to the PRIVATE_KEY from contracts/.env
OPERATOR_PRIVATE_KEY=your_operator_private_key_here
POOL_VAULT_ADDRESS=your_deployed_pool_vault_address_here
